# Xcode and Gradle read the same application name.
set(DRAFTSPAN_NAME_CONFIG "${CMAKE_CURRENT_LIST_DIR}/AppName.xcconfig")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${DRAFTSPAN_NAME_CONFIG}")
file(STRINGS "${DRAFTSPAN_NAME_CONFIG}" DRAFTSPAN_APP_NAME REGEX "^DRAFTSPAN_APP_NAME[ \t]*=")
string(REGEX REPLACE "^DRAFTSPAN_APP_NAME[ \t]*=[ \t]*" "" DRAFTSPAN_APP_NAME "${DRAFTSPAN_APP_NAME}")
